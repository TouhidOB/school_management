# Root env for docker-compose. Copy to `.env` and change secrets before any
# real deploy. Consumed by the backend container (env_file) and by compose for
# ${VAR} substitution in docker-compose.yml.

# --- Postgres ---
POSTGRES_DB=schoolsaas
POSTGRES_USER=sms
POSTGRES_PASSWORD=change-me-strong-password

# --- Django core ---
DEBUG=False
SECRET_KEY=change-me-generate-a-new-one
# Django checks the Host header. nginx forwards the browser's Host (localhost).
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx
PLATFORM_DOMAIN=platform.local
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- CORS: origins allowed to call the API from a browser ---
# Same-origin through nginx needs nothing, but keep localhost:3000 for the
# split-origin `npm run dev` workflow.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

# --- First-run demo data (optional): set to 1 to seed on backend boot ---
SEED_DEMO=0

# --- JWT lifetimes (optional overrides) ---
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
