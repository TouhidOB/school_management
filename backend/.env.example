# Copy to .env and fill in. NEVER commit the real .env.

# --- Core (required) ---
DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-generate-a-new-one
# Comma-separated. Include the base domain and a leading-dot wildcard for tenants.
ALLOWED_HOSTS=platform.local,.platform.local
PLATFORM_DOMAIN=platform.local

# Origins allowed to POST (login/forms) across tenant subdomains. Wildcard OK.
# CSRF_TRUSTED_ORIGINS=https://platform.local,https://*.platform.local

# --- Database (required in prod; falls back to SQLite if unset) ---
# Postgres (VPS / managed):
# DATABASE_URL=postgres://user:pass@localhost:5432/schoolsaas
# MySQL / MariaDB (cPanel shared hosting):
# DATABASE_URL=mysql://user:pass@localhost:3306/schoolsaas
# DB_CONN_MAX_AGE=60

# --- Static / media ---
# Set True only on shared hosting where you can't configure Apache for /media/.
# SERVE_MEDIA=False

# --- TLS / security (defaults are safe; override only if TLS not at a proxy) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Email (password resets / notifications) ---
# EMAIL_HOST=smtp.yourhost.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@platform.local
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=noreply@platform.local

# --- Celery (only if you wire up background jobs; needs Redis) ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LOG_LEVEL=INFO
